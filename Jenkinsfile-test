pipeline {
  agent any

  environment {
    DOCKER_IMAGE_NAME="test-labs"
    DOCKER_TAG="${BUILD_NUMBER}"
    DOCKER_FILE="Dockerfile-test"
    CLIENT_URL="test-labs.app.pb.utfpr.edu.br"
    HOST_PORT=8141
    CONTAINER_PORT=80
  }
  stages {
    stage('Docker Compose UP') {
      steps {
        sh 'docker compose -f docker-compose-test.yml up -d --build'
      }
    }
  }
}
